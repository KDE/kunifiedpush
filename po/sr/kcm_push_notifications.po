#: selftest.cpp:34
#, kde-format
msgid "The operation timed out."
msgstr "Истекло је време за поступак."

#: selftest.cpp:59
#, kde-format
msgid "Push notification self-test."
msgstr "Самопроба пуш обавештења."

#: selftest.cpp:73
#, kde-format
msgid "Could not obtain push notification endpoint."
msgstr "Не могу да добавим крајњу тачку за пуш обавештења."

#: selftest.cpp:126
#, kde-format
msgid "Received notification does not have the expected content."
msgstr "Примљено обавештење нема очекивани садржај."

#: ui/main.qml:28
#, kde-format
msgid "There is no push notification service running!"
msgstr "Није покренут ниједан сервис за пуш обавештења!"

#: ui/main.qml:37
#, kde-format
msgid ""
"There is a 3rd party push notification service running. Push notifications "
"are available, but cannot be configured here."
msgstr ""
"Покренут је сервис треће стране за пуш обавештења. Пуш обавештења су "
"доступна, али се не могу подесити овде."

#: ui/main.qml:46
#, kde-format
msgid ""
"<b>Online</b><br>Connected to the push notification server and operational."
msgstr "<b>На вези</b><br/>Повезано са сервером за пуш обавештења и ради."

#: ui/main.qml:55
#, kde-format
msgid "<b>Idle</b><br>There are no applications using push notifications."
msgstr "<b>Мирује</b><br/>Нема програма који користе пуш обавештења."

#: ui/main.qml:65
#, kde-format
msgid ""
"<b>Offline</b><br>Network connection to the server could not be established "
"(%1)."
msgstr ""
"<b>Ван везе</b><br/>Не могу да успоставим мрежну везу са сервером (%1)."

#: ui/main.qml:66
#, kde-format
msgid ""
"<b>Offline</b><br>Network connection to the server could not be established."
msgstr "<b>Ван везе</b><br/>Не могу да успоставим мрежну везу са сервером."

#: ui/main.qml:76
#, kde-format
msgid "<b>Offline</b><br>Could not authenticate at the server (%1)."
msgstr "<b>Ван везе</b><br/>Не могу да се аутентификујем на серверу (%1)."

#: ui/main.qml:77
#, kde-format
msgid "<b>Offline</b><br>Could not authenticate at the server."
msgstr "<b>Ван везе</b><br/>Не могу да се аутентификујем на серверу."

#: ui/main.qml:86
#, kde-format
msgid "<b>Offline</b><br>Push notifications are not set up yet."
msgstr "<b>Ван везе</b><br/>Пуш обавештења још нису подешена."


msgstr "Primljeno obaveštenje nema očekivani sadržaj."

#: ui/main.qml:28
#, kde-format
msgid "There is no push notification service running!"
msgstr "Nije pokrenut nijedan servis za puš obaveštenja!"

#: ui/main.qml:37
#, kde-format
msgid ""
"There is a 3rd party push notification service running. Push notifications "
"are available, but cannot be configured here."
msgstr ""
"Pokrenut je servis treće strane za puš obaveštenja. Puš obaveštenja su "
"dostupna, ali se ne mogu podesiti ovde."

#: ui/main.qml:46
#, kde-format
msgid ""
"<b>Online</b><br>Connected to the push notification server and operational."
msgstr "<b>Na vezi</b><br/>Povezano sa serverom za puš obaveštenja i radi."

#: ui/main.qml:55
#, kde-format
msgid "<b>Idle</b><br>There are no applications using push notifications."
msgstr "<b>Miruje</b><br/>Nema programa koji koriste puš obaveštenja."

#: ui/main.qml:65
#, kde-format
msgid ""
"<b>Offline</b><br>Network connection to the server could not be established "
"(%1)."
msgstr ""
"<b>Van veze</b><br/>Ne mogu da uspostavim mrežnu vezu sa serverom (%1)."

#: ui/main.qml:66
#, kde-format
msgid ""
"<b>Offline</b><br>Network connection to the server could not be established."
msgstr "<b>Van veze</b><br/>Ne mogu da uspostavim mrežnu vezu sa serverom."

#: ui/main.qml:76
#, kde-format
msgid "<b>Offline</b><br>Could not authenticate at the server (%1)."
msgstr "<b>Van veze</b><br/>Ne mogu da se autentifikujem na serveru (%1)."

#: ui/main.qml:77
#, kde-format
msgid "<b>Offline</b><br>Could not authenticate at the server."
msgstr "<b>Van veze</b><br/>Ne mogu da se autentifikujem na serveru."

#: ui/main.qml:86
#, kde-format
msgid "<b>Offline</b><br>Push notifications are not set up yet."
msgstr "<b>Van veze</b><br/>Puš obaveštenja još nisu podešena."

